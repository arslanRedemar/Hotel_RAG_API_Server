# ===== 서버 =====
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
HOTEL_NAME=My Hotel

# ===== 보안 =====
# openssl rand -hex 32 로 생성
SECRET_KEY=changeme-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== OpenAI =====
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ===== Vector Store =====
CHROMA_PERSIST_DIR=./data/chroma_db

# ===== RAG 파라미터 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=hotel_rag
# 로컬 직접 실행 시
MYSQL_URL=mysql+pymysql://root:password@localhost:3306/hotel_rag

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== 파일 저장소 =====
FILE_STORAGE_PATH=./data/uploads

# ===== 이메일 (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@hotel.com
SMTP_PASSWORD=

# ===== Web Push (VAPID) =====
# pywebpush 로 키 생성: vapid keygen
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# ===== PMS 연동 (선택) =====
PMS_BASE_URL=
PMS_API_KEY=

# ===== OCR (선택) =====
GOOGLE_VISION_API_KEY=

# ===== 수익 관리 =====
TOTAL_ROOMS=200

# ===== LangSmith (MCP / 트레이싱) =====
# smith.langchain.com 에서 발급
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=hotel-ax
